@model CreatorGrowthLab.UI.Controllers.DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Historical Analysis";

    string F0(double x) => x.ToString("N0", CultureInfo.InvariantCulture);
    string F2(double x) => x.ToString("0.##", CultureInfo.InvariantCulture);
    string P2(double x) => (x * 100.0).ToString("0.##", CultureInfo.InvariantCulture) + "%";
}

<div class="max-w-7xl mx-auto space-y-10 animate-in fade-in slide-in-from-bottom-4 duration-1000">

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2">
            <div class="flex items-center gap-3">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-[0.2em] bg-slate-900 text-white shadow-lg shadow-slate-200">
                    Archive Snapshot
                </span>
                <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                    ID: @Model.Response!.Meta.ChannelId
                </span>
            </div>
            <h1 class="text-4xl font-display font-black text-slate-900 tracking-tight">
                Historical <span class="text-indigo-600">Performance Report</span>
            </h1>
            <p class="text-slate-500 font-medium italic">
                Captured on @Model.Response.Meta.GeneratedAt.ToString("MMMM dd, yyyy") at @Model.Response.Meta.GeneratedAt.ToString("HH:mm") UTC
            </p>
        </div>

        <div class="flex items-center gap-3">
            <a asp-controller="History" asp-action="Index"
               class="group flex items-center gap-2 px-6 py-3 rounded-2xl bg-white border border-slate-200 text-sm font-bold text-slate-600 hover:text-indigo-600 hover:border-indigo-200 transition-all shadow-sm">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
                Back to Archive
            </a>
            <button onclick="window.print()" class="p-3 rounded-2xl bg-white border border-slate-200 text-slate-400 hover:text-slate-600 transition-all shadow-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-indigo-600 rounded-[2rem] p-8 text-white shadow-xl shadow-indigo-100">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] opacity-70 mb-1">Target Identity</p>
            <p class="text-xl font-bold truncate">@Model.Response.Meta.ChannelId</p>
            <div class="mt-6 flex items-center gap-2 text-indigo-200">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
                <span class="text-xs font-bold uppercase tracking-widest">Metadata Locked</span>
            </div>
        </div>

        <div class="bg-white rounded-[2rem] border border-slate-200 p-8 shadow-sm">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Sample Depth</p>
            <p class="text-3xl font-black text-slate-900">@Model.Response.Meta.NVideos <span class="text-sm font-bold text-slate-400">Videos</span></p>
            <p class="text-xs text-slate-500 mt-2 font-medium">Full historical reach analyzed</p>
        </div>

        <div class="bg-white rounded-[2rem] border border-slate-200 p-8 shadow-sm">
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Analysis Window</p>
            <p class="text-3xl font-black text-slate-900">@Model.Response.Meta.BaselineWindow <span class="text-sm font-bold text-slate-400">Days</span></p>
            <p class="text-xs text-slate-500 mt-2 font-medium">Standardized relative baseline</p>
        </div>
    </div>

    @if (Model.Response.Warnings?.Any() == true)
    {
        <div class="relative overflow-hidden rounded-3xl bg-amber-50 border border-amber-100 p-8">
            <div class="absolute -right-4 -top-4 text-amber-100/50">
                <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            </div>
            <h3 class="flex items-center gap-2 font-black text-amber-900 uppercase tracking-widest text-xs mb-4">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                Statistical Integrity Notes
            </h3>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2">
                @foreach (var w in Model.Response.Warnings)
                {
                    <li class="flex items-start gap-2 text-sm text-amber-800/80 font-medium leading-tight">
                        <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                        @w
                    </li>
                }
            </ul>
        </div>
    }

    <div class="space-y-12">
        @await Html.PartialAsync("Partials/_KpiCards", Model.Response)

        <div class="bg-white rounded-[3rem] border border-slate-200/60 p-2 shadow-sm">
             @await Html.PartialAsync("Partials/_TrendChart", Model.Response)
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 items-start">
            @await Html.PartialAsync("Partials/_DriversTable", Model.Response)
            @await Html.PartialAsync("Partials/_Recommendations", Model.Response)
        </div>
    </div>

    <div class="flex flex-col items-center gap-4 py-12 border-t border-slate-100">
        <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded bg-slate-100 text-[10px] font-black text-slate-500 uppercase">Ver 4.1</span>
            <span class="text-xs font-bold text-slate-400">GrowthLab Forensic Suite</span>
        </div>
        <p class="text-[10px] font-bold text-slate-300 uppercase tracking-[0.3em]">
            Immutable Snapshot &bull; Read-Only Analysis
        </p>
    </div>
</div>