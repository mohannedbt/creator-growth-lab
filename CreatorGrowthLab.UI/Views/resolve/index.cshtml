@model CreatorGrowthLab.UI.Controllers.ResolveViewModel

@{
    ViewData["Title"] = "ID Resolver";
}

<div class="max-w-5xl mx-auto space-y-12 animate-in fade-in slide-in-from-bottom-4 duration-1000">
    
    <div class="relative group rounded-[3rem] border border-slate-200/60 bg-white shadow-2xl shadow-indigo-100/50 overflow-hidden">
        
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-indigo-500/5 blur-3xl group-hover:bg-indigo-500/10 transition-colors duration-700"></div>
        <div class="absolute -left-20 -bottom-20 h-64 w-64 rounded-full bg-blue-500/5 blur-3xl group-hover:bg-blue-500/10 transition-colors duration-700"></div>

        <div class="relative p-10 lg:p-16 text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 mb-6">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-500"></span>
                </span>
                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Metadata Engine v4.0</span>
            </div>

            <h1 class="text-4xl lg:text-6xl font-display font-black tracking-tight text-slate-900 mb-6">
                Resolve <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600">Channel Identity</span>
            </h1>
            
            <p class="text-slate-500 max-w-xl mx-auto font-medium text-lg leading-relaxed mb-10">
                Enter a YouTube handle or URL to extract the unique system ID required for deep-data mapping.
            </p>

            <form method="post" class="max-w-2xl mx-auto">
                @Html.AntiForgeryToken()
                <div class="relative flex items-center p-2 rounded-[2rem] bg-slate-100/50 border border-slate-200 focus-within:bg-white focus-within:ring-4 focus-within:ring-indigo-500/10 transition-all duration-300">
                    <div class="pl-6 text-slate-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    
                    <input asp-for="Input" 
                           class="flex-1 bg-transparent border-0 focus:ring-0 text-lg font-bold text-slate-900 placeholder-slate-400 px-4 py-4" 
                           placeholder="@@handle or youtube.com/c/name" />

                    <button type="submit" class="bg-slate-900 hover:bg-indigo-600 text-white px-8 py-4 rounded-2xl font-black text-xs uppercase tracking-widest transition-all shadow-lg hover:shadow-indigo-500/25 active:scale-95">
                        Resolve
                    </button>
                </div>
                
                <div class="mt-4 flex items-center justify-center gap-6">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">UCID Extraction</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Handle Mapping</span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="max-w-2xl mx-auto">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="rounded-[2rem] bg-rose-50 border border-rose-100 p-8 text-center animate-in zoom-in-95">
                <div class="h-12 w-12 rounded-2xl bg-white text-rose-500 flex items-center justify-center mx-auto mb-4 shadow-sm">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h3 class="text-sm font-black text-rose-900 uppercase tracking-widest">Resolution Failed</h3>
                <p class="text-rose-700 mt-2 font-medium">@Model.ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ChannelId))
        {
            <div class="group bg-white rounded-[2.5rem] border border-slate-200/60 p-10 shadow-xl shadow-slate-200/50 animate-in slide-in-from-top-8 duration-500">
                <div class="text-center space-y-8">
                    <div>
                        <div class="h-16 w-16 rounded-3xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-4 ring-8 ring-emerald-50/50">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <h3 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em]">Identity Confirmed</h3>
                    </div>

                    <div class="relative py-6 px-8 rounded-3xl bg-slate-50 border border-slate-100 flex items-center justify-between group/id">
                        <div class="flex flex-col items-start">
                            <span class="text-[10px] font-black text-slate-400 uppercase mb-1">Channel System ID</span>
                            <code class="text-xl font-black text-indigo-600 tracking-tight">@Model.ChannelId</code>
                        </div>
                        <button onclick="copyId('@Model.ChannelId')" class="p-3 rounded-xl bg-white border border-slate-200 text-slate-400 hover:text-indigo-600 hover:border-indigo-200 transition-all shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        </button>
                    </div>

                    <a class="flex items-center justify-center gap-3 w-full py-5 rounded-2xl bg-indigo-600 text-white font-black uppercase tracking-widest text-sm transition-all hover:bg-indigo-700 hover:shadow-2xl hover:shadow-indigo-500/40 active:scale-[0.98]"
                       asp-controller="Dashboard" asp-action="Index" asp-route-channelId="@Model.ChannelId">
                        Open Growth Analytics
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function copyId(text) {
        navigator.clipboard.writeText(text);
        // Add a temporary success toast or button state change here for better UX
    }
</script>