@model CreatorGrowthLab.UI.Models.Analytics.AnalyticsResponse
@using System.Globalization

@{
    string F0(double x) => x.ToString("N0", CultureInfo.InvariantCulture);
    string F2(double x) => x.ToString("0.##", CultureInfo.InvariantCulture);
    string P2(double x) => (x * 100.0).ToString("0.##", CultureInfo.InvariantCulture) + "%";

    var kpis = new[]
    {
        new {
            Title = "Volume",
            Value = Model.Kpis.VideosAnalyzed.ToString(),
            Subtitle = "Videos in dataset",
            Color = "slate",
            Icon = "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
        },
        new {
            Title = "Baseline",
            Value = F0(Model.Kpis.BaselineViewsPerDay),
            Subtitle = "Median Views/Day",
            Color = "blue",
            Icon = "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
        },
        new {
            Title = "Efficiency",
            Value = $"{F2(Model.Kpis.MedianRelativePerformance)}x",
            Subtitle = "Performance Lift",
            Color = "indigo",
            Icon = "M13 10V3L4 14h7v7l9-11h-7z"
        },
        new {
            Title = "Engagement",
            Value = P2(Model.Kpis.AvgEngagementRate),
            Subtitle = "Interaction Ratio",
            Color = "emerald",
            Icon = "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
        }
    };
}

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
    @foreach (var kpi in kpis)
    {
        <div class="group relative bg-white rounded-[2rem] border border-slate-200/60 p-7 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-@kpi.Color-500/5 hover:-translate-y-1 overflow-hidden">
            
            <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full bg-@kpi.Color-50/50 flex items-center justify-center transition-transform duration-500 group-hover:scale-110">
                <svg class="h-10 w-10 text-@kpi.Color-500/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@kpi.Icon" />
                </svg>
            </div>

            <div class="relative z-10 space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-@kpi.Color-50 text-@kpi.Color-600 transition-colors group-hover:bg-@kpi.Color-600 group-hover:text-white">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="@kpi.Icon" />
                        </svg>
                    </div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">@kpi.Title</span>
                </div>

                <div>
                    <div class="text-4xl font-display font-black text-slate-900 tracking-tight">
                        @kpi.Value
                    </div>
                    <div class="mt-1 flex items-center gap-1.5">
                        <p class="text-xs font-bold text-slate-500">@kpi.Subtitle</p>
                        <div class="h-1 w-1 rounded-full bg-slate-300"></div>
                        <span class="text-[10px] font-bold text-@kpi.Color-600 uppercase">Live</span>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-0 left-0 h-1 bg-@kpi.Color-500/20 w-full">
                <div class="h-full bg-@kpi.Color-500 transition-all duration-1000 w-0 group-hover:w-full"></div>
            </div>
        </div>
    }
</div>