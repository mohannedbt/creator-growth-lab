@model CreatorGrowthLab.UI.Models.Analytics.AnalyticsResponse
@using System.Text.Json
@using System.Globalization

@{
    var ordered = Model.Trends?
        .OrderBy(t => t.PublishedAt)
        .ToList() ?? new();

    var trendLabels = JsonSerializer.Serialize(
        ordered.Select(t => t.PublishedAt.ToString("MMM dd", CultureInfo.InvariantCulture))
    );

    var relPerf = JsonSerializer.Serialize(
        ordered.Select(t => t.RelativePerformance)
    );
}

<div class="group relative rounded-[2rem] border border-slate-200/60 bg-white shadow-sm transition-all duration-300 hover:shadow-md overflow-hidden">
    <div class="flex items-center justify-between px-8 py-6 border-b border-slate-100 bg-slate-50/30">
        <div>
            <h3 class="text-lg font-bold text-slate-900 tracking-tight">Performance Velocity</h3>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mt-0.5">
                Relative performance Baseline (1.0x = Average)
            </p>
        </div>
        
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-indigo-500 shadow-[0_0_10px_rgba(99,102,241,0.5)]"></span>
                <span class="text-[11px] font-bold text-slate-600 uppercase">Velocity</span>
            </div>
        </div>
    </div>

    <div class="p-8 pt-4">
        <div class="h-80 w-full">
            <canvas
                id="trendChart"
                class="transition-opacity duration-500"
                data-labels='@Html.Raw(trendLabels)'
                data-values='@Html.Raw(relPerf)'>
            </canvas>
        </div>
    </div>

    @if (ordered.Any())
    {
        <div class="px-8 py-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-tighter">
                Sample Period: @ordered.First().PublishedAt.ToString("MMM yyyy") - @ordered.Last().PublishedAt.ToString("MMM yyyy")
            </span>
            <button class="text-[11px] font-bold text-indigo-600 hover:text-indigo-700 uppercase tracking-widest transition-colors">
                Export CSV
            </button>
        </div>
    }
</div>