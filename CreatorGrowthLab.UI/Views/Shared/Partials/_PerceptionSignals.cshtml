@model CreatorGrowthLab.UI.Models.Analytics.AnalyticsResponse

<div class="rounded-[2.5rem] border border-slate-200/60 bg-white shadow-sm overflow-hidden">
  <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/30">
    <h3 class="text-lg font-bold text-slate-900">Viewer Perception Signals</h3>
    <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mt-0.5">
      Observational patterns (not guarantees)
    </p>
  </div>
    @if (Model.PerceptionSignals == null || !Model.PerceptionSignals.Any())
    {
        <div class="px-8 py-6">
        <p class="text-sm text-slate-600">No perception signals detected at this time.</p>
        </div>
    }
  else
  {
    <div class="divide-y divide-slate-100">

      
        @foreach (var a in Model.PerceptionSignals)
        {
        <div class="px-8 py-6 hover:bg-slate-50 transition-colors">
          <div class="flex items-start justify-between gap-6">
            <div>
              <div class="flex items-center gap-2">
                <h4 class="font-black text-slate-900">@a.Signal</h4>
                <span class="text-[10px] font-black uppercase tracking-widest px-2 py-1 rounded-full bg-slate-100 text-slate-600">
                  @a.Category
                </span>
              </div>
              <p class="mt-1 text-sm text-slate-600">@a .Description</p>
              <p class="mt-2 text-sm font-bold text-slate-700">@a.Tendency</p>
            </div>

            <span class="shrink-0 text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-full
              @(a.Confidence == "high" ? "bg-slate-900 text-white" :
                a.Confidence == "medium" ? "bg-slate-200 text-slate-800" :
                "bg-slate-100 text-slate-500")">
              @a.Confidence
            </span>
          </div>
        </div>
        }
      
    </div>
  }
</div>
