@model List<CreatorGrowthLab.UI.Models.Analytics.TopicSummary>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
@foreach (var t in Model)
{
    var status = t.Momentum >= 0.10 ? "Rising" : t.Momentum <= -0.10 ? "Fatiguing" : "Stable";
    
    var themeColor = status switch {
        "Rising" => "emerald",
        "Fatiguing" => "rose",
        _ => "indigo"
    };

    <div class="group relative bg-white rounded-[2.5rem] border border-slate-200/60 p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1 overflow-hidden">
        
        <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-@themeColor-500/5 blur-3xl group-hover:bg-@themeColor-500/10 transition-colors"></div>

        <div class="flex items-start justify-between mb-10">
            <div>
                <h3 class="text-2xl font-display font-black text-slate-900 tracking-tight group-hover:text-@themeColor-600 transition-colors">
                    @t.Label
                </h3>
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Dataset: @t.NVideos Videos</span>
                    <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Confidence: @((t.Confidence * 100).ToString("0"))%</span>
                </div>
            </div>

            <div class="flex flex-col items-end">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider
                             bg-@themeColor-50 text-@themeColor-600 ring-1 ring-inset ring-@themeColor-600/20">
                    @status
                </span>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-4">
            <div class="space-y-1">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Efficiency</p>
                <p class="text-2xl font-black text-slate-900">@t.MedianRelativePerformance.ToString("0.00")<span class="text-sm font-bold text-slate-400">x</span></p>
                <div class="h-1 w-full bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-@themeColor-500 w-[@(Math.Min(t.MedianRelativePerformance * 20, 100))%]"></div>
                </div>
            </div>

            <div class="space-y-1 border-x border-slate-100 px-4">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Hit Rate</p>
                <p class="text-2xl font-black text-slate-900">@((t.HitRate * 100).ToString("0"))<span class="text-sm font-bold text-slate-400">%</span></p>
                <p class="text-[10px] font-medium text-slate-500">Reliability score</p>
            </div>

            <div class="space-y-1 pl-4">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Variance</p>
                <div class="flex flex-col">
                    <span class="text-sm font-bold text-slate-900 leading-tight">@t.BestRecent.ToString("0.0")x <span class="text-slate-300 font-medium">peak</span></span>
                    <span class="text-sm font-bold text-slate-400 leading-tight">@t.WorstRecent.ToString("0.0")x <span class="text-slate-300 font-medium">floor</span></span>
                </div>
            </div>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="flex -space-x-2">
                    @* Just visual fluff to simulate "Top Videos in this topic" *@
                    <div class="h-6 w-6 rounded-full border-2 border-white bg-slate-200"></div>
                    <div class="h-6 w-6 rounded-full border-2 border-white bg-slate-300"></div>
                </div>
                <span class="text-[11px] font-bold text-slate-500 uppercase">Momentum: @t.Momentum.ToString("+0.00;-0.00;0.00")</span>
            </div>
            
            <button class="flex items-center gap-2 text-xs font-bold text-indigo-600 hover:gap-3 transition-all">
                View Drilldown
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </button>
        </div>
    </div>
}
</div>