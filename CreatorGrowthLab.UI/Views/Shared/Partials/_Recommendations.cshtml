@model CreatorGrowthLab.UI.Models.Analytics.AnalyticsResponse
@using System.Globalization

@{
    string F2(double x) => x.ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="relative overflow-hidden rounded-[2.5rem] border border-slate-200/60 bg-white shadow-sm transition-all duration-300">
    
    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/30 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-600 text-white shadow-lg shadow-emerald-200/50">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-display font-black text-slate-900 tracking-tight">Action Items</h2>
                <div class="flex items-center gap-2 mt-0.5">
                    <span class="flex h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Growth Intelligence Active</p>
                </div>
            </div>
        </div>
    </div>

    <div class="p-8 space-y-6">
        @foreach (var r in Model.Recommendations)
        {
            var isPositive = r.ExpectedImpactPercent >= 0;
            var conf = r.Confidence.ToLowerInvariant();
            
            var confClass = conf switch {
                "high" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
                "medium" => "bg-amber-50 text-amber-700 ring-amber-600/20",
                _ => "bg-slate-50 text-slate-600 ring-slate-600/20"
            };

            <div class="group relative rounded-3xl border border-slate-100 bg-white p-6 transition-all duration-300 hover:shadow-xl hover:shadow-slate-100 hover:border-indigo-100">
                
                <div class="flex items-start justify-between gap-4 mb-3">
                    <h3 class="text-md font-bold text-slate-900 leading-snug group-hover:text-indigo-600 transition-colors">
                        @r.Title
                    </h3>
                    <span class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-black uppercase tracking-wider ring-1 ring-inset @confClass">
                        @conf
                    </span>
                </div>

                <p class="text-sm text-slate-500 font-medium leading-relaxed mb-6">
                    @r.Detail
                </p>

                <div class="flex items-center justify-between pt-4 border-t border-slate-50">
                    <div class="flex flex-col gap-1">
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Projected Growth</span>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center @(isPositive ? "text-emerald-600" : "text-rose-600")">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" 
                                          d="@(isPositive ? "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" : "M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6")" />
                                </svg>
                                <span class="text-sm font-black tracking-tight">
                                    @(isPositive ? "+" : "")@F2(r.ExpectedImpactPercent)%
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-1">
                        @for (int i = 1; i <= 5; i++)
                        {
                            @* Visualizing impact magnitude by bar count *@
                            var isActive = Math.Abs(r.ExpectedImpactPercent) / 5 >= i;
                            <div class="h-4 w-1.5 rounded-full @(isActive ? (isPositive ? "bg-emerald-500" : "bg-rose-500") : "bg-slate-100")"></div>
                        }
                    </div>
                </div>
                
                <div class="absolute bottom-0 left-6 right-6 h-1 bg-indigo-500 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 rounded-t-full"></div>
            </div>
        }
    </div>
    
    <div class="bg-slate-50/50 px-8 py-4 text-center border-t border-slate-100">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]">
            Recommendations are weighted by volatility and confidence intervals
        </p>
    </div>
</div>