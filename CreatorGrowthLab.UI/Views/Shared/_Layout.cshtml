@using System.Security.Claims

@{
    // --- Page detection (for active nav + dynamic rightbar) ---
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";

    string NavClass(string startsWith)
        => path.StartsWith(startsWith)
            ? "nav-item-active flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-bold transition-all"
            : "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-white hover:text-indigo-600 transition-all";

    string PageKey()
        => path.StartsWith("/resolve") ? "resolve"
         : path.StartsWith("/history") ? "history"
         : "dashboard";

    var pageKey = PageKey();
    var userName = User?.Identity?.Name ?? "User";
    var initials = string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(initials)) initials = "U";
}

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Creator Growth Lab</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                        display: ['Outfit', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f5f3ff', 100: '#ede9fe', 200: '#ddd6fe', 300: '#c4b5fd',
                            400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9',
                        }
                    }
                }
            }
        }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">

    <style>
        body { background: #fcfdfe; height: 100vh; overflow: hidden; }
        .font-display { font-family: 'Outfit', sans-serif; }

        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e2e8f0;
            border-radius: 20px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

        .nav-item-active {
            background: white;
            box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            color: #4f46e5;
        }
    </style>
</head>

<body class="antialiased flex flex-col text-slate-900">

<header class="h-16 shrink-0 z-[60] sticky top-0 bg-white/70 backdrop-blur-md border-b border-slate-200/60 px-8 flex items-center justify-between">
    <div class="flex items-center gap-8">
        <a href="/" class="group flex items-center gap-3">
            <div class="h-9 w-9 rounded-xl bg-slate-950 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </div>
            <span class="text-xl font-display font-black tracking-tight text-slate-900 uppercase">GrowthLab</span>
        </a>
    </div>

    <div class="flex items-center gap-6">
        @RenderSection("TopbarRight", required: false)

        <!-- Dynamic Rightbar (changes per page) -->
        <div class="hidden lg:flex items-center gap-3 px-3 py-1.5 rounded-2xl border border-slate-200 bg-white/60">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Context</span>

            <div class="rb-pane @(pageKey == "dashboard" ? "" : "hidden")" data-pane="dashboard">
                <span class="text-xs font-bold text-slate-700">Dashboard</span>
                <span class="text-xs text-slate-500">Run analysis & view insights</span>
            </div>

            <div class="rb-pane @(pageKey == "resolve" ? "" : "hidden")" data-pane="resolve">
                <span class="text-xs font-bold text-slate-700">Get Channel ID</span>
                <span class="text-xs text-slate-500">Resolve @@channel → ID</span>
            </div>

            <div class="rb-pane @(pageKey == "history" ? "" : "hidden")" data-pane="history">
                <span class="text-xs font-bold text-slate-700">History</span>
                <span class="text-xs text-slate-500">Your saved runs</span>
            </div>
        </div>

        <div class="h-8 w-[1px] bg-slate-200 hidden sm:block"></div>

        <!-- User + Logout (clear) -->
        <div class="flex items-center gap-3">
            <div class="group flex items-center gap-3 pl-1 pr-3 py-1 rounded-full bg-slate-100 hover:bg-white border border-transparent hover:border-slate-200 transition-all">
                <div class="h-8 w-8 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold text-xs">@initials</div>
                <span class="text-sm font-bold text-slate-700">Welcome @userName</span>
            </div>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-50 text-rose-700 font-black text-xs uppercase tracking-widest border border-rose-200 hover:bg-rose-100 transition-all"
                            onclick="return confirm('Log out now?');">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
                        </svg>
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a href="/Account/Login"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white font-black text-xs uppercase tracking-widest hover:bg-slate-800 transition-all">
                    Login
                </a>
            }
        </div>
    </div>
</header>

<div class="flex flex-1 overflow-hidden">

    <aside class="w-64 shrink-0 bg-slate-50/50 border-r border-slate-200/60 hidden md:block">
        <div class="flex flex-col h-full p-6">
            <nav class="space-y-6">
                <div>
                    <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 px-3 mb-4">Analytics</div>
                    <div class="space-y-1">
                        <a href="/" class="@NavClass("/")">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                            </svg>
                            Dashboard
                        </a>

                        <!-- Renamed Resolver -->
                        <a href="/Resolve" class="@NavClass("/resolve")">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M8 7h8M8 11h8M8 15h6M6 3h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2z" />
                            </svg>
                            Get Channel ID
                        </a>

                        <a href="/History" class="@NavClass("/history")">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            History
                        </a>
                    </div>
                </div>

                <div>
                    <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 px-3 mb-4">Insights</div>
                    <div class="space-y-1">
                        <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-white hover:text-indigo-600 transition-all">
                            Benchmarks
                        </a>
                        <a href="#" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-white hover:text-indigo-600 transition-all">
                            Topic Map
                        </a>
                    </div>
                </div>
            </nav>

            <div class="mt-auto pt-6">
                <div class="p-4 bg-gradient-to-br from-indigo-600 to-violet-700 rounded-2xl shadow-xl shadow-indigo-200">
                    <p class="text-xs font-bold text-indigo-100 uppercase tracking-wider mb-2">Pro Plan</p>
                    <p class="text-[11px] text-white/80 leading-relaxed mb-4">Unlock 24-month historical snapshots and AI predictions.</p>
                    <button class="w-full py-2 bg-white text-indigo-600 text-[11px] font-black uppercase rounded-lg shadow-sm">Upgrade</button>
                </div>
            </div>
        </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-y-auto custom-scrollbar">
        <main class="flex-1 p-8 lg:p-12">
            <div class="max-w-7xl mx-auto">
                @RenderBody()
            </div>
        </main>

        <footer class="mt-auto border-t border-slate-200/60 bg-white/50 backdrop-blur-sm">
            <div class="max-w-7xl mx-auto px-8 py-10">
                <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="flex items-center gap-2">
                        <div class="h-6 w-6 rounded bg-slate-900 flex items-center justify-center">
                            <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <span class="text-sm font-display font-black text-slate-900 tracking-tight uppercase">GrowthLab</span>
                    </div>

                    <div class="flex gap-8 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                        <a href="#" class="hover:text-indigo-600">Privacy</a>
                        <a href="#" class="hover:text-indigo-600">Terms</a>
                        <a href="#" class="hover:text-indigo-600">Help</a>
                    </div>

                    <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                        © @(DateTime.Now.Year) Built for Creators
                    </p>
                </div>
            </div>
        </footer>
    </div>
</div>

<script>
    // Client-side rightbar switching (in case your nav links change via JS later).
    // On full page loads, Razor already sets the correct pane.
    (function () {
        const pageKey = "@pageKey";
        const panes = document.querySelectorAll(".rb-pane");
        panes.forEach(p => p.classList.add("hidden"));
        const active = document.querySelector('.rb-pane[data-pane="' + pageKey + '"]');
        if (active) active.classList.remove("hidden");
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

</body>
</html>
