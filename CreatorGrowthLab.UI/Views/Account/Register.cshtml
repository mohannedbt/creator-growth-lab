@model CreatorGrowthLab.UI.Models.Auth.RegisterViewModel
@{
    Layout = "_empty_layout";
}

<div class="min-h-screen bg-slate-950 flex flex-col lg:flex-row overflow-hidden">
    
    <div class="relative hidden lg:flex lg:w-1/2 bg-slate-900 items-center justify-center p-16 overflow-hidden">
        @* Background Glows *@
        <div class="absolute top-0 right-0 w-full h-full opacity-30">
            <div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-cyan-500/20 blur-[120px] rounded-full"></div>
            <div class="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] bg-indigo-500/20 blur-[120px] rounded-full"></div>
        </div>

        <div class="relative z-10 max-w-lg">
            <div class="mb-12">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/20 mb-6">
                    <span class="text-[10px] font-black text-cyan-400 uppercase tracking-[0.2em]">Join 2,500+ Creators</span>
                </div>
                <h2 class="text-5xl font-black text-white leading-tight mb-6">
                    Unlock your <span class="text-cyan-400">Growth</span> potential.
                </h2>
                <p class="text-lg text-slate-400 leading-relaxed">
                    Get access to the same intelligence tools used by top-tier YouTube agencies to scale channels scientifically.
                </p>
            </div>

            <ul class="space-y-6">
                <li class="flex items-start gap-4">
                    <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <div>
                        <h4 class="text-white font-bold">Deep Performance Metrics</h4>
                        <p class="text-sm text-slate-500">Go beyond the basic studio analytics.</p>
                    </div>
                </li>
                <li class="flex items-start gap-4">
                    <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <div>
                        <h4 class="text-white font-bold">AI Strategy Engine</h4>
                        <p class="text-sm text-slate-500">Instant recommendations based on your data pillars.</p>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <div class="w-full lg:w-1/2 bg-slate-950 flex items-center justify-center p-8 sm:p-12 lg:p-20">
        <div class="w-full max-w-md">
            
            <div class="mb-10">
                <h1 class="text-3xl font-bold text-white mb-2">Create Account</h1>
                <p class="text-slate-500">Join the Lab and start your first analysis.</p>
            </div>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="mb-4 rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
        <div asp-validation-summary="All"></div>
    </div>
}


            <form asp-action="Register" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="space-y-4">
                    <div class="group">
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-cyan-400 transition-colors">
                            Work Email
                        </label>
                        <input asp-for="Email" 
                               class="w-full bg-slate-900/50 border border-slate-800 text-white rounded-2xl px-5 py-4 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/10 transition-all placeholder:text-slate-700"
                               placeholder="creator@example.com" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="group">
                            <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-indigo-400 transition-colors">
                                Password
                            </label>
                            <input asp-for="Password" type="password"
                                   class="w-full bg-slate-900/50 border border-slate-800 text-white rounded-2xl px-5 py-4 focus:outline-none focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 transition-all"
                                   placeholder="••••••••" />
                        </div>
                        <div class="group">
                            <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-indigo-400 transition-colors">
                                Confirm
                            </label>
                            <input asp-for="ConfirmPassword" type="password"
                                   class="w-full bg-slate-900/50 border border-slate-800 text-white rounded-2xl px-5 py-4 focus:outline-none focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 transition-all"
                                   placeholder="••••••••" />
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full py-4 bg-white text-slate-950 font-black rounded-2xl hover:bg-cyan-50 transition-all active:scale-[0.98] shadow-xl shadow-white/5">
                        Start Your Free Trial
                    </button>
                </div>
            </form>

            <div class="mt-12 pt-8 border-t border-slate-900 flex justify-between items-center">
                <p class="text-slate-500 text-sm">Already have an account?</p>
                <a asp-action="Login" class="text-white font-bold hover:text-cyan-400 transition-colors text-sm">
                    Sign In
                </a>
            </div>
        </div>
    </div>
</div>