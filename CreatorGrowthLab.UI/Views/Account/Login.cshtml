@model CreatorGrowthLab.UI.Models.Auth.LoginViewModel
@{
    Layout = "_empty_layout";
}
<div>


</div>
<div class="min-h-screen bg-slate-950 flex flex-col lg:flex-row overflow-hidden">
    
    <div class="relative hidden lg:flex lg:w-7/12 xl:w-8/12 bg-slate-900 items-center justify-center p-12 overflow-hidden">
        @* Background Decorations *@
        <div class="absolute top-0 left-0 w-full h-full opacity-40">
            <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-500/20 blur-[120px] rounded-full"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-cyan-500/10 blur-[120px] rounded-full"></div>
        </div>

        <div class="relative z-10 max-w-2xl">
            <div class="inline-flex items-center gap-3 px-4 py-2 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md mb-8">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                    <span class="relative inline-flex h-3 w-3 rounded-full bg-indigo-500"></span>
                </span>
                <span class="text-xs font-black text-indigo-200 uppercase tracking-widest">Platform Online: v2.4.0</span>
            </div>

            <h2 class="text-6xl xl:text-7xl font-black text-white leading-tight mb-6">
                Master your <br />
                <span class="bg-gradient-to-r from-indigo-400 via-blue-400 to-cyan-400 bg-clip-text text-transparent">Digital Destiny.</span>
            </h2>
            
            <p class="text-xl text-slate-400 leading-relaxed mb-12 max-w-lg">
                The most advanced YouTube intelligence engine for high-growth creators and agencies.
            </p>

            <div class="grid grid-cols-2 gap-6 text-slate-300">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg bg-indigo-500/10 border border-indigo-500/20">
                        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <span class="font-semibold">Real-time Velocity</span>
                </div>
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg bg-cyan-500/10 border border-cyan-500/20">
                        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    </div>
                    <span class="font-semibold">Competitor Benchmarks</span>
                </div>
            </div>
        </div>
    </div>

    <div class="w-full lg:w-5/12 xl:w-4/12 bg-slate-950 flex items-center justify-center p-8 sm:p-12 lg:p-20 relative">
        <div class="w-full max-w-sm relative z-10">
            
            <div class="lg:hidden mb-12">
                <h1 class="text-3xl font-black text-white">Growth Intelligence</h1>
            </div>

            <div class="mb-10">
                <h2 class="text-3xl font-bold text-white mb-2">Sign In</h2>
                <p class="text-slate-500">Enter your credentials to access the lab.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-8 p-4 bg-rose-500/10 border border-rose-500/20 rounded-2xl">
                    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="text-sm text-rose-400 font-medium">@e.ErrorMessage</p>
                    }
                </div>
            }

            <form asp-action="Login" method="post" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="space-y-5">
                    <div class="group">
                        <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em] mb-2 group-focus-within:text-indigo-400 transition-colors">
                            Professional Email
                        </label>
                        <div class="relative">
                            <input asp-for="Email" 
                                   class="w-full bg-slate-900/50 border border-slate-800 text-white rounded-2xl px-5 py-4 focus:outline-none focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 transition-all placeholder:text-slate-700"
                                   placeholder="name@creator.com" />
                        </div>
                    </div>

                    <div class="group">
                        <div class="flex justify-between mb-2">
                            <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em] group-focus-within:text-indigo-400 transition-colors">
                                Password
                            </label>
                            <a href="#" class="text-xs font-bold text-indigo-400 hover:text-indigo-300">Forgot?</a>
                        </div>
                        <input asp-for="Password" type="password"
                               class="w-full bg-slate-900/50 border border-slate-800 text-white rounded-2xl px-5 py-4 focus:outline-none focus:border-indigo-500/50 focus:ring-4 focus:ring-indigo-500/10 transition-all placeholder:text-slate-700"
                               placeholder="••••••••" />
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <input asp-for="RememberMe" class="w-5 h-5 rounded-lg border-slate-800 bg-slate-900 text-indigo-600 focus:ring-offset-slate-950" />
                    <label class="text-sm text-slate-400 font-medium cursor-pointer">Keep me logged in</label>
                </div>

                <button type="submit" class="w-full py-4 bg-white text-slate-950 font-black rounded-2xl hover:bg-indigo-50 transition-all active:scale-[0.98] shadow-xl shadow-white/5">
                    Continue to Dashboard
                </button>
            </form>

            <div class="mt-12 pt-8 border-t border-slate-900 text-center">
                <p class="text-slate-500 text-sm">
                    New to the Lab? 
                    <a asp-action="Register" class="text-white font-bold hover:text-indigo-400 transition-colors underline underline-offset-8 decoration-indigo-500/30">
                        Create an account
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>